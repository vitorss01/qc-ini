	measure 'Deslocamento vs Alvo (SD)' =
			VAR d = [Media Observada] - [Media Alvo]
			VAR sd = AVERAGE ( Fato_QC[DP_Alvo] )
			RETURN IF ( sd > 0, DIVIDE ( d, sd ) )
		formatString: #,0.00
		displayFolder: 07 Tendencia
		lineageTag: 30c9398f-b271-568d-a59c-6cc88b9a11ad

		annotation PBI_FormatHint = {}

	measure 'Media Movel 7 Corridas' =
			VAR corridaAtual = SELECTEDVALUE ( Fato_QC[RUN] )
			RETURN CALCULATE ( AVERAGE ( Fato_QC[Resultado] ), FILTER ( ALLSELECTED ( Fato_QC ), Fato_QC[RUN] <= corridaAtual && Fato_QC[RUN] > corridaAtual - 7 ) )
		formatString: #,0.000
