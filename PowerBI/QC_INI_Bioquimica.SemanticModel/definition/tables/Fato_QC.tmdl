	measure 'Grupos Sem Meta' = COUNTROWS ( FILTER ( SUMMARIZE ( Fato_QC, Fato_QC[ID_Analito], Fato_QC[Nivel], Fato_QC[ID_Lote] ), ISBLANK ( CALCULATE ( AVERAGE ( Fato_QC[ETp_pct] ) ) ) ) )
