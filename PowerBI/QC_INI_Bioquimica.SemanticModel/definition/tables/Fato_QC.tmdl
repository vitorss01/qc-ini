	measure 'Pior CV' =
			VAR t = FILTER (
			    SUMMARIZE ( Fato_QC, Fato_QC[Analito], Fato_QC[Nivel] ),
			    NOT ISBLANK ( CALCULATE ( AVERAGE ( Fato_QC[CV_Observado_pct] ) ) ) )
			VAR alvo = TOPN ( 1, t, CALCULATE ( AVERAGE ( Fato_QC[CV_Observado_pct] ) ), DESC )
			RETURN CONCATENATEX ( alvo, Fato_QC[Analito] & "  N" & Fato_QC[Nivel], ", " )
		displayFolder: 08 Executivo
		lineageTag: 10317195-6714-55ec-b688-f36de0194132

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pior Bias' =
			VAR t = FILTER (
			    SUMMARIZE ( Fato_QC, Fato_QC[Analito], Fato_QC[Nivel] ),
			    NOT ISBLANK ( CALCULATE ( AVERAGE ( Fato_QC[Bias_Observado_pct] ) ) ) )
			VAR alvo = TOPN ( 1, t, CALCULATE ( AVERAGE ( Fato_QC[Bias_Observado_pct] ) ), DESC )
			RETURN CONCATENATEX ( alvo, Fato_QC[Analito] & "  N" & Fato_QC[Nivel], ", " )
		displayFolder: 08 Executivo
		lineageTag: 1f7a7c17-5dff-523f-9736-1aa756812bd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pior ET' =
			VAR t = FILTER (
			    SUMMARIZE ( Fato_QC, Fato_QC[Analito], Fato_QC[Nivel] ),
			    NOT ISBLANK ( CALCULATE ( AVERAGE ( Fato_QC[ET_Observado_pct] ) ) ) )
			VAR alvo = TOPN ( 1, t, CALCULATE ( AVERAGE ( Fato_QC[ET_Observado_pct] ) ), DESC )
			RETURN CONCATENATEX ( alvo, Fato_QC[Analito] & "  N" & Fato_QC[Nivel], ", " )
		displayFolder: 08 Executivo
		lineageTag: 4094c276-19d6-5076-b74f-3928cc2a7b21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pior Sigma' =
			VAR t = FILTER (
			    SUMMARIZE ( Fato_QC, Fato_QC[Analito], Fato_QC[Nivel] ),
			    NOT ISBLANK ( CALCULATE ( AVERAGE ( Fato_QC[Sigma_Obs] ) ) ) )
			VAR alvo = TOPN ( 1, t, CALCULATE ( AVERAGE ( Fato_QC[Sigma_Obs] ) ), ASC )
			RETURN CONCATENATEX ( alvo, Fato_QC[Analito] & "  N" & Fato_QC[Nivel], ", " )
		displayFolder: 08 Executivo
		lineageTag: b20b8de4-158c-51de-a41b-69ffd86c755f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Status CV' = SWITCH ( [Status CV], "Conforme", "#1E8449", "Proximo ao limite", "#D68910", "Nao conforme", "#C0392B", "#595959" )
		displayFolder: 09 Cores
		lineageTag: 50aa67bf-47f9-5242-8b07-a4011ed4f122

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Status Bias' = SWITCH ( [Status Bias], "Conforme", "#1E8449", "Proximo ao limite", "#D68910", "Nao conforme", "#C0392B", "#595959" )
		displayFolder: 09 Cores
		lineageTag: 147353e7-9c2e-5b21-8592-1af0c2edeecf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Status ET' = SWITCH ( [Status ET], "Conforme", "#1E8449", "Proximo ao limite", "#D68910", "Nao conforme", "#C0392B", "#595959" )
		displayFolder: 09 Cores
		lineageTag: 22dc8c52-09e8-5f51-bc1c-02fdbd5cfd03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Sigma' =
			VAR s = [Sigma]
			RETURN SWITCH ( TRUE (), ISBLANK ( s ), "#595959", s < 3, "#C0392B", s < 4, "#D68910", "#1E8449" )
		displayFolder: 09 Cores
		lineageTag: e7546060-a9d7-53c7-8eda-241740c1803f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Veredito' = IF ( [n Rejeitados] > 0, "#C0392B", "#1E8449" )
		displayFolder: 09 Cores
		lineageTag: b473006a-2e9f-5487-9a9f-47e74600a829

		annotation PBI_FormatHint = {"isGeneralNumber":true}

