		annotation PBI_FormatHint = {}

	measure 'Status Global' =
			VAR s = [Sigma]
			VAR fora = [% Fora de Controle]
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( [n Resultados] ), "SEM DADOS",
			    ISBLANK ( s ), "SEM META",
			    s < 3 || fora > 5, "FORA DE CONTROLE",
			    s < 4 || fora > 2, "ATENCAO",
			    "SOB CONTROLE" )
		displayFolder: 08 Executivo
		lineageTag: 3515fcc6-0ec1-5e75-a38a-a41a940973a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Status Global' = SWITCH ( [Status Global], "FORA DE CONTROLE", "#C0392B", "ATENCAO", "#D68910", "SOB CONTROLE", "#1E8449", "#7F8C8D" )
		displayFolder: 08 Executivo
		lineageTag: 45eb41c7-b9c3-56fa-bf75-ca2f2cba3517

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Periodo Analisado' =
			VAR a = MIN ( Fato_QC[Data] )
			VAR b = MAX ( Fato_QC[Data] )
			RETURN IF ( NOT ISBLANK ( a ), FORMAT ( a, "dd/mm/yyyy" ) & "  ate  " & FORMAT ( b, "dd/mm/yyyy" ) )
		displayFolder: 08 Executivo
		lineageTag: d9ec3aaf-a9bb-5dde-a16c-411768d526af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Atualizado Em' =
			VAR t = MAX ( Fato_QC[AtualizadoEmUTC] )
			RETURN IF ( NOT ISBLANK ( t ), "Dados do QC_INI de " & t & " (UTC)" )
		displayFolder: 08 Executivo
		lineageTag: 63575701-4e77-50be-86a9-8845d94c0f88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Veredito Atual' =
			VAR ultRun = MAX ( Fato_QC[RUN] )
			RETURN CALCULATE ( CONCATENATEX ( VALUES ( Fato_QC[Veredito] ), Fato_QC[Veredito], " / " ), Fato_QC[RUN] = ultRun )
		displayFolder: 02 Descritiva
		lineageTag: bdf5c262-9026-5a84-a875-772c8365db4b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Situacao da Especificacao' =
			VAR n = DISTINCTCOUNT ( Fato_QC[Situacao_Especificacao] )
			RETURN IF ( n = 1, SELECTEDVALUE ( Fato_QC[Situacao_Especificacao] ), FORMAT ( n, "0" ) & " situações" )
