_backup_pre_fase*/
_backup_autorecuperacao/

# Saidas geradas
outputs/

# Builds do hardening: .xlsm e ARTEFATO, nao fonte.
# A fonte oficial do codigo e _arquitetura/snapshot_producao/<produto>/vba/.
# A build e reproduzivel a partir da producao + scripts_fase3/.
_arquitetura/build_hardening*/

# Backups do arquivo de producao: o Git ja e o historico.
_arquitetura/_backup_producao/

# Cache e preferencias locais que o Power BI Desktop grava dentro do PBIP.
# cache.abf e copia dos dados do laboratorio; localSettings guarda caminhos
# desta maquina. Nada disso e fonte -- e estado de uma instalacao.
PowerBI/**/.pbi/
